# PostgreSQL connection string. Example: postgresql://postgres:password@localhost:5432/campusrent?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/campusrent?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
PORT=3000
NODE_ENV=development
# Optional: comma-separated origins if frontend is hosted separately. Leave empty for same-origin deployment.
CORS_ORIGIN=""
MAX_UPLOAD_MB=5
