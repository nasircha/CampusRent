# PostgreSQL connection string. Example: postgresql://postgres:password@localhost:5432/campusrent?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/campusrent?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
PORT=3000
NODE_ENV=development
# Optional: comma-separated origins if frontend is hosted separately. Leave empty for same-origin deployment.
CORS_ORIGIN=""
MAX_UPLOAD_MB=5

# Cloudinary permanent image storage (required for listing photo uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Admin account email (must match a registered, verified CampusRent account)
ADMIN_EMAIL="mdnasirhussain121@gmail.com"
