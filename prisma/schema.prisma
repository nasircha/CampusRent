generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  college      String   @default("")
  email        String   @unique
  emailVerified Boolean @default(false)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  items        Item[]   @relation("ItemOwner")
  rentalsAsOwner  Rental[] @relation("RentalOwner")
  rentalsAsRenter Rental[] @relation("RentalRenter")
  conversationsAsRenter Conversation[] @relation("ConversationRenter")
  messagesSent         Message[]      @relation("MessageSender")
  @@index([createdAt])
}

model Item {
  id        String   @id @default(cuid())
  title     String
  cat       String
  cond      String
  price     Int
  deposit   Int      @default(0)
  loc       String
  desc      String   @default("")
  photo     String   @default("")
  status    String   @default("available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String
  owner     User     @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  rentals   Rental[]
  conversations Conversation[]
  @@index([status, cat, createdAt])
  @@index([ownerId, status])
}

model Rental {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  renterId    String
  renter      User     @relation("RentalRenter", fields: [renterId], references: [id], onDelete: Restrict)
  ownerId     String
  owner       User     @relation("RentalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  itemTitle   String
  cat         String
  photo       String   @default("")
  price       Int
  days        Int
  rent        Int
  deposit     Int
  start       DateTime @db.Date
  note        String   @default("")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  returnedAt  DateTime?
  @@index([ownerId, status, createdAt])
  @@index([renterId, status, createdAt])
  @@index([itemId, status, start])
}

enum OtpChannel {
  EMAIL
  PHONE
}

model OtpChallenge {
  id          String     @id @default(cuid())
  channel     OtpChannel
  destination String
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([destination, channel, createdAt])
  @@index([expiresAt])
}
model Conversation {
  id                String   @id @default(cuid())
  itemId            String
  renterId          String
  renterLastReadAt  DateTime?
  ownerLastReadAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item     Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  renter   User      @relation("ConversationRenter", fields: [renterId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([itemId, renterId])
  @@index([renterId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now())
  seenAt         DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}