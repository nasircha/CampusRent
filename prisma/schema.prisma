generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  college      String   @default("")
  email        String   @unique
  emailVerified Boolean @default(false)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  items        Item[]   @relation("ItemOwner")
  itemRatings  ItemRating[]
  rentalsAsOwner  Rental[] @relation("RentalOwner")
  rentalsAsRenter Rental[] @relation("RentalRenter")
  conversationsAsRenter Conversation[] @relation("ConversationRenter")
  messagesSent         Message[]      @relation("MessageSender")
  directRequestsSent   DirectMessageRequest[] @relation("DirectRequestSender")
  directRequestsReceived DirectMessageRequest[] @relation("DirectRequestReceiver")
  directChatsStarted   DirectChat[] @relation("DirectChatStarter")
  directChatsReceived  DirectChat[] @relation("DirectChatReceiver")
  directMessagesSent   DirectChatMessage[] @relation("DirectMessageSender")
  @@index([createdAt])
}

model Item {
  id        String   @id @default(cuid())
  title     String
  cat       String
  cond      String
  price     Int
  deposit   Int      @default(0)
  loc       String
  desc      String   @default("")
  photo     String   @default("")
  status    String   @default("available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String
  owner     User     @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ratings   ItemRating[]
  rentals   Rental[]
  conversations Conversation[]
  @@index([status, cat, createdAt])
  @@index([ownerId, status])
}

model Rental {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  renterId    String
  renter      User     @relation("RentalRenter", fields: [renterId], references: [id], onDelete: Restrict)
  ownerId     String
  owner       User     @relation("RentalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  itemTitle   String
  cat         String
  photo       String   @default("")
  price       Int
  days        Int
  rent        Int
  deposit     Int
  start       DateTime @db.Date
  note        String   @default("")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  returnedAt  DateTime?
  @@index([ownerId, status, createdAt])
  @@index([renterId, status, createdAt])
  @@index([itemId, status, start])
}

enum OtpChannel {
  EMAIL
  PHONE
}

model OtpChallenge {
  id          String     @id @default(cuid())
  channel     OtpChannel
  destination String
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([destination, channel, createdAt])
  @@index([expiresAt])
}
model Conversation {
  id                String   @id @default(cuid())
  itemId            String
  renterId          String
  renterLastReadAt  DateTime?
  ownerLastReadAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  archivedAt        DateTime?

  item     Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  renter   User      @relation("ConversationRenter", fields: [renterId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([itemId, renterId])
  @@index([renterId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now())
  seenAt         DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model DirectMessageRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sender     User @relation("DirectRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("DirectRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model DirectChat {
  id         String   @id @default(cuid())
  starterId  String
  receiverId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  starter    User @relation("DirectChatStarter", fields: [starterId], references: [id], onDelete: Cascade)
  receiver   User @relation("DirectChatReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  messages   DirectChatMessage[]
  @@unique([starterId, receiverId])
  @@index([receiverId, updatedAt])
}

model DirectChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  seenAt    DateTime?
  chat      DirectChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  @@index([chatId, createdAt])
}
model UserActivity {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  college   String   @default("")
  email     String
  event     String
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([email, createdAt])
}


model ItemRating {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId, updatedAt])
}
